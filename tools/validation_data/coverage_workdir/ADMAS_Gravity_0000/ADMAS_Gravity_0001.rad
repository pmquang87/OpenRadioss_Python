#RADIOSS ENGINE
#
#KEYWORD TO RUN SIMULATION NUMBER 1 - MODIFY NUMBER IF RESTART FILE
/RUN/1ELEM_SAMP/1
#FINAL TIME OF THE SIMULATION - TO BE MODIFIED
250.0
#
#
/TITLE
SAMP
#
#KEYWORD TO HAVE EXACTLY THE SAME RESULTS WHATEVER THE CPUS NUMBER - AUTOMATICALLY ON 
/PARITH/ON
#
#Provides an estimation of the CPU time spent for each processor.
/MON/ON
#
#
#
#=====================================================#
#                      TIME STEP                      #
#=====================================================#
#ELEMENTARY TIME STEP - UNCOMMENT IF WANT TO USE IT
#/DT
#0.9 0.0
#
#NODAL TIME STEP - UNCOMMENT IF WANT TO USE IT
/DT/NODA
 0.9 0.0
#
#NODAL TIME STEP WITH ADDED MASS - UNCOMMENT IF WANT TO USE IT
# !!! NOT TO BE USED WITH EULERIAN FORMULATION !!!
#/DT/NODA/CST
#0.9 0.0003
#
#NODAL TIME STEP WITH ADDED MASS ON A SPECIFIC SET OF NODES - UNCOMMENT IF WANT TO USE IT
#/DT/NODA/CST/1
#0.9 0.0003
#ID SET DE NOEUD

#ALE TIME STEP - UNCOMMENT IF WANT TO USE IT
#DEFAULT SCALE FACTOR IS 0.5
#/DT/ALE
# 0 0
#
#
#
#=====================================================#
#                 OUTPUT TIME STEP                    #
#=====================================================#
#
#OUTPUT FREQUENCY OF H3D FILES - TO BE MODIFIED ACCORDING TO SIMULATION TIME (TARGET AT LEAST 30 OUTPUTS - TO BE ADJUSTED ACCORDING TO THE SCENARIO)
/H3D/DT
0.000000e+000 10.0
#
#
#OUTPUT A FINAL ANIMATION IF SIMULATION FAILS DUE TO EXCESSIVE ADDED MASS OR ENERGY ERROR
/STOP
0 0 0 1 1
#
#
#OUTPUT FREQUENCY OF TIME HISTORY FILE (TH) - TO BE MODIFIED ACCORDING TO SIMULATION TIME (TARGET AT LEAST 1000 OUTPUTS - TO BE ADJUSTED ACCORDING TO THE SCENARIO)
/TFILE/4
2.25e-2
#
#
#OUTPUT FREQUENCY OF SIMULATION DATAS IN 0001.out FILE (/PRINT/-1 = every 1 cycle ; /PRINT/-100 = every 100 cycles) - DEBUG = EVERY 1 CYCLE - PERFORMANCE = EVERY 100 or 1000 CYCLES
/PRINT/-100/0
#
#
OUTPUT FREQUENCY OF RESTART FILES (.rst) - IN CYCLES
/RFILE
1000000 
#
#
#
#=====================================================#
#                 H3D CONTOUR REQUEST                 #
#=====================================================#
#------------------------------
#MASS, ADDED MASSS & TIME STEPS OUTPUTS 
#/H3D/NODA/DMASS
/H3D/NODA/MASS
#/H3D/MASS
/H3D/SHELL/MASS
/H3D/SHELL/DT
#/H3D/SOLID/MASS
#/H3D/SOLID/DT
#/H3D/SPRING/DT
#------------------------------
#NODAL VECTORS OUTPUTS
#/H3D/NODA/DIS
/H3D/NODA/VEL
#/H3D/NODA/ACC
#/H3D/NODA/CONT
#/H3D/NODA/CONT2
/H3D/NODA/FEXT
/H3D/NODA/FINT
#------------------------------
#ELEMENTAL OUTPUTS
#ELEMENTAL ENERGIES
/H3D/SHELL/HOURGLASS
#/H3D/SOLID/HOURGLASS
/H3D/SHELL/DENS
#/H3D/SOLID/DENS
/H3D/SHELL/ENER
#/H3D/SOLID/ENER
#------------------------------
# 1D ELEMENTS FORCE OUTPUTS
#/H3D/SPRING/FORC
#/H3D/BEAM/FORC
#------------------------------
# 2D ELEMENTS THICKNESS, Plastic STRAIN, STRESS&STRAIN TENSORS OUTPUTS
/H3D/SHELL/THICK
/H3D/SHELL/EPSP/NPT=ALL
/H3D/SHELL/EPSD
/H3D/SHELL/TENS/STRESS/NPT=ALL
/H3D/SHELL/TENS/STRAIN/NPT=ALL
# 2D ELEMENTS DAMAGE OUTPUTS
#/H3D/SHELL/DAMA
/H3D/SHELL/DAMA/NPT=ALL
#/H3D/SHELL/DAMAG/NPT=ALL
#------------------------------
# 3D ELEMENTS VON MISES, Plastic STRAIN, STRESS&STRAIN TENSORS OUTPUTS
#/H3D/SOLID/VONM
#/H3D/SOLID/EPSP
#/H3D/SOLID/TENS/STRESS/NPT=ALL
#/H3D/SOLID/TENS/STRAIN/NPT=ALL
# 3D ELEMENTS DAMAGE OUTPUTS
#/H3D/SOLID/TENS/DAMA
