# implicitly apply the pre-load caused by the rotation structure via /LOAD/CENTRI
/RUN/fan_blade_initialize/1
            0.1 # implicit end time
/VERS/140
/TFILE/0
#            dT_HIS
0.000050
/RFILE
#   NCYCLE     IREAD     IWRITE
100000 0 0
/ANIM/DT
#   TSTART     TFREQ
0.000000 0.01
/ANIM/SHELL/TENS/STRAIN/ALL
/ANIM/BRICK/TENS/STRAIN
/ANIM/SHELL/TENS/STRESS/ALL
/ANIM/ELEM/EPSP
/ANIM/VECT/PCONT
/ANIM/VECT/VEL
/ANIM/ELEM/ENER
/ANIM/GZIP
/PARITH/ON
/MON/ON
/PRINT/-1
# Printout frequency for nonlinear computation:
/IMPL/PRINT/NONL/-1
# Direct Linear Solver method using default options
/IMPL/SOLVER/3
 
# Initial implicit time step
/IMPL/DTINI
0.01000000E+00
#Implicit Minimum and Maximum Time Step 
/IMPL/DT/STOP 
0.01000000E-04 0.03000000E+00
# Nonlinear solutmion method, Modified Newton Method
/IMPL/NONLIN/1
         0         12 0.1000000E-01 0.1000000E-01
# automatic timestep control         
/IMPL/DT/2
         6 0.0000000E+00         20 0.6700000E+00 0.1100000E+01
#Line search methods for nonlinear analysis.
/IMPL/LSEARCH/1
        20    1.0000000000E-03
/STATE/SHELL/STRESS/FULL
/STATE/SHELL/AUX/FULL 
/STATE/SHELL/STRAIN/FULL        
/STATE/DT
0.1 0.1
1
