    *TimeScales(1, 1, 1, 1)
    *TimeDelays(0, 0, 0, 0)
    *AnimationEnable(1, 1, 1, 1)
    *SyncTolerance(2e-08)
    *SyncTableGenerationPolicy(ALL_BLOCKS)
    *PageAnimationSyncPolicy(CLOSEST)
*EndPage()
